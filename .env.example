# Optional LLM API keys for Interview Studio Stages 2-4 rubric grading.
# Leave blank to use the built-in offline deterministic rubric evaluator.
LLM_PROVIDER=auto # auto | anthropic | openai | gemini | offline
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Modal GPU endpoint for remote CUDA/Triton kernel & lab benchmarking
MODAL_GPU_ENDPOINT=
MODAL_API_TOKEN=

# Local server URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
